{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "agent_metrics — métricas de comportamiento del agente",
  "description": "Dataset del dashboard 'Comportamiento del agente' (scripts/agent-metrics-tracker.py). Series compactas de tareas para recalcular percentiles por ventana en el viz; provenances y cobertura por fuente explícitas.",
  "type": "object",
  "required": [
    "metadata",
    "days",
    "sources",
    "models",
    "daily",
    "tasks",
    "repos",
    "months"
  ],
  "additionalProperties": false,
  "properties": {
    "metadata": {
      "type": "object",
      "required": [
        "date_range",
        "task_definition",
        "gap_cap_minutes",
        "retry_window_minutes",
        "provenance",
        "coverage",
        "reasons"
      ],
      "additionalProperties": true,
      "properties": {
        "date_range": {
          "type": "object",
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "end": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            }
          }
        },
        "first_task": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_task": {
          "type": [
            "string",
            "null"
          ]
        },
        "task_definition": {
          "type": "string",
          "minLength": 20
        },
        "gap_cap_minutes": {
          "type": "integer",
          "minimum": 1
        },
        "retry_window_minutes": {
          "type": "integer",
          "minimum": 1
        },
        "config_source": {
          "type": [
            "string",
            "null"
          ]
        },
        "provenance": {
          "type": "object",
          "required": [
            "tasks",
            "aborts",
            "tool_errors",
            "repos"
          ],
          "additionalProperties": {
            "enum": [
              "reported",
              "derived",
              "cached",
              "missing",
              "assumed"
            ]
          }
        },
        "coverage": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "source",
              "turn_level",
              "abort_signal",
              "sessions"
            ],
            "additionalProperties": false,
            "properties": {
              "source": {
                "type": "string"
              },
              "turn_level": {
                "type": "boolean"
              },
              "abort_signal": {
                "type": "boolean"
              },
              "sessions": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "cost_parity": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "coffe-dnx.3: alcance declarado del gate de paridad de coste (session_spend también incluye amp, omp, codex y otras fuentes que agent_metrics no procesa)."
              },
              "note": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "reasons": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "timezone": {
          "type": [
            "string",
            "null"
          ]
        },
        "repo_roots_missing": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "orphan_turns": {
          "type": "integer",
          "minimum": 0
        },
        "preamble_prompts_skipped": {
          "type": "integer",
          "minimum": 0
        },
        "min_commit_days": {
          "type": "integer",
          "minimum": 1
        },
        "min_returning_months": {
          "type": "integer",
          "minimum": 1
        },
        "bulk_day_interactions": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "days": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "models": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "daily": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "prompts",
          "tasks",
          "turns",
          "agent_s"
        ],
        "additionalProperties": false,
        "properties": {
          "prompts": {
            "type": "integer",
            "minimum": 0
          },
          "tasks": {
            "type": "integer",
            "minimum": 0
          },
          "turns": {
            "type": "integer",
            "minimum": 0
          },
          "agent_s": {
            "type": "number",
            "minimum": 0
          },
          "aborted": {
            "type": "integer",
            "minimum": 0
          },
          "errors": {
            "type": "integer",
            "minimum": 0
          },
          "tool_errors": {
            "type": "integer",
            "minimum": 0
          },
          "retry": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "tasks": {
      "type": "object",
      "description": "Series paralelas: day=índice en days, s=segundos ocupados, sp=segundos de reloj de la tarea, src/model=índices, f=bitmask (1 aborted, 2 error, 4 tool_error, 8 retry). coffe-dnx.3: sid=índice en sessions[] (null si la tarea no conoce su sesión), cost=coste de los turnos assistant, tokens={in,out,cache_read,cache_write} acumulados. Las claves nuevas no son required: datasets anteriores al cambio o con regen pendiente no las traen.",
      "required": [
        "day",
        "s",
        "sp",
        "src",
        "model",
        "f"
      ],
      "additionalProperties": false,
      "properties": {
        "day": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "s": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "src": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "model": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "f": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "sp": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "sid": {
          "type": "array",
          "description": "Índice en sessions[]; null si la tarea no conoce su sesión.",
          "items": {
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "cost": {
          "type": "array",
          "description": "Coste (usage.cost.total) de los turnos assistant de la tarea.",
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "tokens": {
          "type": "array",
          "description": "Tokens acumulados de los turnos assistant de la tarea.",
          "items": {
            "type": "object",
            "required": [
              "in",
              "out",
              "cache_read",
              "cache_write"
            ],
            "additionalProperties": false,
            "properties": {
              "in": {
                "type": "integer",
                "minimum": 0
              },
              "out": {
                "type": "integer",
                "minimum": 0
              },
              "cache_read": {
                "type": "integer",
                "minimum": 0
              },
              "cache_write": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "sessions": {
      "type": "array",
      "description": "coffe-dnx.3: sesiones con al menos una tarea, en orden de primera aparición; tasks.sid indexa acá. Una sesión sin tareas (prompt abortado antes de la respuesta) no aparece. Opcional: datasets anteriores al cambio no la traen.",
      "items": {
        "type": "object",
        "required": [
          "source",
          "project",
          "session_id"
        ],
        "additionalProperties": false,
        "properties": {
          "source": {
            "type": "string"
          },
          "project": {
            "type": [
              "string",
              "null"
            ]
          },
          "session_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "repos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "first_commit",
          "days_by_month"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "first_commit": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "days_by_month": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "months": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
