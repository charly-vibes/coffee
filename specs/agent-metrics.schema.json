{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "agent_metrics — métricas de comportamiento del agente",
  "description": "Dataset del dashboard 'Comportamiento del agente' (scripts/agent-metrics-tracker.py). Series compactas de tareas para recalcular percentiles por ventana en el viz; provenances y cobertura por fuente explícitas.",
  "type": "object",
  "required": [
    "metadata",
    "days",
    "sources",
    "models",
    "daily",
    "tasks",
    "repos",
    "months"
  ],
  "additionalProperties": false,
  "properties": {
    "metadata": {
      "type": "object",
      "required": [
        "date_range",
        "task_definition",
        "gap_cap_minutes",
        "retry_window_minutes",
        "provenance",
        "coverage",
        "reasons"
      ],
      "additionalProperties": true,
      "properties": {
        "date_range": {
          "type": "object",
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "end": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            }
          }
        },
        "first_task": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_task": {
          "type": [
            "string",
            "null"
          ]
        },
        "task_definition": {
          "type": "string",
          "minLength": 20
        },
        "gap_cap_minutes": {
          "type": "integer",
          "minimum": 1
        },
        "retry_window_minutes": {
          "type": "integer",
          "minimum": 1
        },
        "config_source": {
          "type": [
            "string",
            "null"
          ]
        },
        "provenance": {
          "type": "object",
          "required": [
            "tasks",
            "aborts",
            "tool_errors",
            "repos"
          ],
          "additionalProperties": {
            "enum": [
              "reported",
              "derived",
              "cached",
              "missing",
              "assumed"
            ]
          }
        },
        "coverage": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "source",
              "turn_level",
              "abort_signal",
              "sessions"
            ],
            "additionalProperties": false,
            "properties": {
              "source": {
                "type": "string"
              },
              "turn_level": {
                "type": "boolean"
              },
              "abort_signal": {
                "type": "boolean"
              },
              "sessions": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "cost_parity": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "coffe-dnx.3: alcance declarado del gate de paridad de coste (session_spend también incluye amp, omp, codex y otras fuentes que agent_metrics no procesa)."
              },
              "note": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "reasons": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "timezone": {
          "type": [
            "string",
            "null"
          ]
        },
        "repo_roots_missing": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "orphan_turns": {
          "type": "integer",
          "minimum": 0
        },
        "preamble_prompts_skipped": {
          "type": "integer",
          "minimum": 0
        },
        "min_commit_days": {
          "type": "integer",
          "minimum": 1
        },
        "min_returning_months": {
          "type": "integer",
          "minimum": 1
        },
        "bulk_day_interactions": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "days": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "models": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "daily": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "prompts",
          "tasks",
          "turns",
          "agent_s"
        ],
        "additionalProperties": false,
        "properties": {
          "prompts": {
            "type": "integer",
            "minimum": 0
          },
          "tasks": {
            "type": "integer",
            "minimum": 0
          },
          "turns": {
            "type": "integer",
            "minimum": 0
          },
          "agent_s": {
            "type": "number",
            "minimum": 0
          },
          "aborted": {
            "type": "integer",
            "minimum": 0
          },
          "errors": {
            "type": "integer",
            "minimum": 0
          },
          "tool_errors": {
            "type": "integer",
            "minimum": 0
          },
          "retry": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "tasks": {
      "type": "object",
      "description": "Series paralelas: day=índice en days, s=segundos ocupados, sp=segundos de reloj de la tarea, src/model=índices, f=bitmask (1 aborted, 2 error, 4 tool_error, 8 retry). coffe-dnx.3: sid=índice en sessions[] (null si la tarea no conoce su sesión), cost=coste de los turnos assistant, tokens={in,out,cache_read,cache_write} acumulados. Las claves nuevas no son required: datasets anteriores al cambio o con regen pendiente no las traen.",
      "required": [
        "day",
        "s",
        "sp",
        "src",
        "model",
        "f"
      ],
      "additionalProperties": false,
      "properties": {
        "day": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "s": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "src": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "model": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "f": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "sp": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "sid": {
          "type": "array",
          "description": "Índice en sessions[]; null si la tarea no conoce su sesión.",
          "items": {
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "cost": {
          "type": "array",
          "description": "Coste (usage.cost.total) de los turnos assistant de la tarea.",
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "tokens": {
          "type": "array",
          "description": "Tokens acumulados de los turnos assistant de la tarea.",
          "items": {
            "type": "object",
            "required": [
              "in",
              "out",
              "cache_read",
              "cache_write"
            ],
            "additionalProperties": false,
            "properties": {
              "in": {
                "type": "integer",
                "minimum": 0
              },
              "out": {
                "type": "integer",
                "minimum": 0
              },
              "cache_read": {
                "type": "integer",
                "minimum": 0
              },
              "cache_write": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "sessions": {
      "type": "array",
      "description": "coffe-dnx.3: sesiones con al menos una tarea, en orden de primera aparición; tasks.sid indexa acá. Una sesión sin tareas (prompt abortado antes de la respuesta) no aparece. Opcional: datasets anteriores al cambio no la traen.",
      "items": {
        "type": "object",
        "required": [
          "source",
          "project",
          "session_id"
        ],
        "additionalProperties": false,
        "properties": {
          "source": {
            "type": "string"
          },
          "project": {
            "type": [
              "string",
              "null"
            ]
          },
          "session_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "repos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "first_commit",
          "days_by_month"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "first_commit": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "days_by_month": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "months": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ops": {
      "type": "object",
      "description": "Métricas de continuidad operativa (agent_metrics_ops*.py, epic coffe-a5v). Cada slice se computa sobre población completa, con provenance/coverage por fuente y null-con-razón cuando no hay señal.",
      "$defs": {
        "coverage": {
          "type": "array",
          "description": "Cobertura por fuente para la clave de ops.",
          "items": {
            "type": "object",
            "required": ["source", "coverage_pct"],
            "properties": {
              "source": {"type": "string"},
              "coverage_pct": {"type": "number", "minimum": 0, "maximum": 100},
              "reason": {"type": ["string", "null"]}
            },
            "additionalProperties": false
          }
        },
        "provenance": {
          "type": "object",
          "description": "Léxico: reported/derived/measured/assumed por clave.",
          "additionalProperties": {"type": "string"}
        }
      },
      "required": ["latency"],
      "properties": {
        "latency": {
          "type": "object",
          "required": ["sources", "providers", "provenance", "coverage"],
          "properties": {
            "sources": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "required": ["turns_total", "turns_with_duration", "coverage_pct", "models"],
                "properties": {
                  "turns_total": {"type": "integer", "minimum": 0},
                  "turns_with_duration": {"type": "integer", "minimum": 0},
                  "coverage_pct": {"type": "number", "minimum": 0, "maximum": 100},
                  "reason": {"type": "string"},
                  "models": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "object",
                      "required": ["n", "p50_ms", "p90_ms", "p95_ms", "turns_total", "coverage_pct"],
                      "properties": {
                        "n": {"type": "integer", "minimum": 0},
                        "p50_ms": {"type": ["number", "null"]},
                        "p90_ms": {"type": ["number", "null"]},
                        "p95_ms": {"type": ["number", "null"]},
                        "turns_total": {"type": "integer", "minimum": 0},
                        "coverage_pct": {"type": "number", "minimum": 0, "maximum": 100},
                        "reason": {"type": "string"}
                      },
                      "additionalProperties": false
                    }
                  }
                },
                "additionalProperties": false
              }
            },
            "providers": {
              "type": "object",
              "description": "Roll-up por familia del model_mapping; solo familias con turnos con duración.",
              "additionalProperties": {
                "type": "object",
                "required": ["n", "p50_ms", "p90_ms", "p95_ms", "turns_total", "coverage_pct"],
                "properties": {
                  "n": {"type": "integer", "minimum": 0},
                  "p50_ms": {"type": "number"},
                  "p90_ms": {"type": "number"},
                  "p95_ms": {"type": "number"},
                  "turns_total": {"type": "integer", "minimum": 0},
                  "coverage_pct": {"type": "number", "minimum": 0, "maximum": 100}
                },
                "additionalProperties": false
              }
            },
            "provenance": {
              "type": "object",
              "required": ["latency"],
              "properties": {
                "latency": {"enum": ["measured"]}
              },
              "additionalProperties": false
            },
            "coverage": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["source", "coverage_pct"],
                "properties": {
                  "source": {"type": "string"},
                  "coverage_pct": {"type": "number", "minimum": 0, "maximum": 100},
                  "reason": {"type": ["string", "null"]}
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "fallback": {
          "type": "object",
          "description": "coffe-8mh: fallback de modelo. omp: registros resolvedModelIsFallback reportados; pi/claude-cli: proxy (cambio de modelo a mitad de tarea).",
          "required": ["by_source", "events_total", "provenance", "coverage"],
          "properties": {
            "by_source": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "required": ["method", "events", "denominator", "rate"],
                "properties": {
                  "method": {"enum": ["reported-resolvedModelIsFallback", "proxy-mid-task-switch"]},
                  "events": {"type": "integer", "minimum": 0},
                  "denominator": {"type": "integer", "minimum": 0},
                  "rate": {"type": ["number", "null"]},
                  "reason": {"type": "string"}
                },
                "additionalProperties": false
              }
            },
            "events_total": {"type": "integer", "minimum": 0},
            "provenance": {"$ref": "#/properties/ops/$defs/provenance"},
            "coverage": {"$ref": "#/properties/ops/$defs/coverage"}
          },
          "additionalProperties": false
        },
        "quota_events": {
          "type": "object",
          "description": "coffe-t6e: eventos de agotamiento de cuota detectados por firmas de error de proveedor en turnos raw (errorMessage de pi; claude-cli sin señal de cuota -> razón).",
          "required": ["events", "counts", "sources_without_signature", "provenance", "coverage"],
          "properties": {
            "events": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["ts", "provider", "signature", "source"],
                "properties": {
                  "ts": {"type": "string"},
                  "provider": {"type": "string"},
                  "signature": {"type": "string"},
                  "source": {"type": "string"}
                },
                "additionalProperties": false
              }
            },
            "counts": {
              "type": "object",
              "additionalProperties": {"type": "integer", "minimum": 0}
            },
            "sources_without_signature": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["source", "reason"],
                "properties": {"source": {"type": "string"}, "reason": {"type": "string"}},
                "additionalProperties": false
              }
            },
            "provenance": {"$ref": "#/properties/ops/$defs/provenance"},
            "coverage": {"$ref": "#/properties/ops/$defs/coverage"}
          },
          "additionalProperties": false
        },
        "completion": {
          "type": "object",
          "description": "coffe-af2: % de tareas terminadas autónomamente (sin pushback/error) sobre cohort no ambigua; gate de frescura del estimador (docs/model-cost-estimate-v0.json).",
          "required": ["started", "autonomous", "rate", "ambiguous_share", "cohort", "provenance", "coverage"],
          "properties": {
            "started": {"type": "integer", "minimum": 0},
            "autonomous": {"type": "integer", "minimum": 0},
            "rate": {"type": ["number", "null"]},
            "ambiguous_share": {"type": "number", "minimum": 0, "maximum": 100},
            "cohort": {"const": "unambiguous"},
            "reason": {"type": "string"},
            "provenance": {"$ref": "#/properties/ops/$defs/provenance"},
            "coverage": {"$ref": "#/properties/ops/$defs/coverage"}
          },
          "additionalProperties": false
        },
        "intervention": {
          "type": "object",
          "description": "coffe-af2: intervención humana — aborts + prompts de recuperación en retry_window tras error, por 100 beads aceptadas (n_beads_sin_coste/no_table del estimador excluidas).",
          "required": ["aborts", "recovery_prompts", "per_100_accepted", "provenance", "coverage"],
          "properties": {
            "aborts": {"type": "integer", "minimum": 0},
            "recovery_prompts": {"type": "integer", "minimum": 0},
            "per_100_accepted": {"type": ["number", "null"]},
            "accepted_beads": {"type": ["integer", "null"], "minimum": 0},
            "reason": {"type": "string"},
            "provenance": {"$ref": "#/properties/ops/$defs/provenance"},
            "coverage": {"$ref": "#/properties/ops/$defs/coverage"}
          },
          "additionalProperties": false
        },
        "subscription": {
          "type": "object",
          "description": "coffe-9fp: utilización de suscripción — coste notional (de usage_report session_spend, lane notional) vs cuota mensual reportada de config; sin cifras inventadas.",
          "required": ["periods", "models_without_period", "provenance", "coverage"],
          "properties": {
            "periods": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["source", "label", "monthly_fee", "cost_imputed", "utilization"],
                "properties": {
                  "source": {"type": "string"},
                  "label": {"type": "string"},
                  "start": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
                  "end": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
                  "monthly_fee": {"type": "number", "minimum": 0},
                  "cost_imputed": {"type": ["number", "null"]},
                  "utilization": {"type": ["number", "null"]},
                  "headroom_daily": {"type": ["number", "null"]},
                  "reason": {"type": "string"}
                },
                "additionalProperties": false
              }
            },
            "models_without_period": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["model", "reason"],
                "properties": {"model": {"type": "string"}, "reason": {"type": "string"}},
                "additionalProperties": false
              }
            },
            "provenance": {"$ref": "#/properties/ops/$defs/provenance"},
            "coverage": {"$ref": "#/properties/ops/$defs/coverage"}
          },
          "additionalProperties": false
        },
        "concurrency": {
          "type": "object",
          "description": "coffe-qi7: saturación — p95 diario de agentes activos y de requests en vuelo (turnos que se solapan en el tiempo), no agentes configurados.",
          "required": ["daily", "agents_p95", "requests_p95", "provenance", "coverage"],
          "properties": {
            "daily": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["day", "agents_p95", "requests_p95"],
                "properties": {
                  "day": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
                  "agents_p95": {"type": "number"},
                  "requests_p95": {"type": ["number", "null"]},
                  "reason": {"type": "string"}
                },
                "additionalProperties": false
              }
            },
            "agents_p95": {"type": ["number", "null"]},
            "requests_p95": {"type": ["number", "null"]},
            "reason": {"type": "string"},
            "provenance": {"$ref": "#/properties/ops/$defs/provenance"},
            "coverage": {"$ref": "#/properties/ops/$defs/coverage"}
          },
          "additionalProperties": false
        },
        "stall": {
          "type": "object",
          "description": "coffe-qi7: minutos por día adyacentes a error/retry y minutos idle entre tareas.",
          "required": ["daily", "totals", "provenance", "coverage"],
          "properties": {
            "daily": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["day", "minutes_error_adjacent", "minutes_idle"],
                "properties": {
                  "day": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
                  "minutes_error_adjacent": {"type": "number", "minimum": 0},
                  "minutes_idle": {"type": "number", "minimum": 0}
                },
                "additionalProperties": false
              }
            },
            "totals": {
              "type": "object",
              "required": ["minutes_error_adjacent", "minutes_idle"],
              "properties": {
                "minutes_error_adjacent": {"type": "number", "minimum": 0},
                "minutes_idle": {"type": "number", "minimum": 0}
              },
              "additionalProperties": false
            },
            "provenance": {"$ref": "#/properties/ops/$defs/provenance"},
            "coverage": {"$ref": "#/properties/ops/$defs/coverage"}
          },
          "additionalProperties": false
        },
        "queue_wait": {
          "type": "object",
          "description": "coffe-qi7: TTFT/cola no medible en logs locales -> null con razón (no 0).",
          "required": ["value", "reason", "provenance"],
          "properties": {
            "value": {"const": null},
            "reason": {"const": "no_ttft_in_local_logs"},
            "provenance": {"$ref": "#/properties/ops/$defs/provenance"}
          },
          "additionalProperties": false
        },
        "provenance": {
          "type": "object",
          "description": "Léxico compartido: reported/derived/measured/assumed por clave de ops.",
          "additionalProperties": {"type": "string"}
        },
        "coverage": {
          "type": "array",
          "description": "Cobertura por fuente para las claves de ops.",
          "items": {
            "type": "object",
            "required": ["source", "coverage_pct"],
            "properties": {
              "source": {"type": "string"},
              "coverage_pct": {"type": "number", "minimum": 0, "maximum": 100},
              "reason": {"type": ["string", "null"]}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
