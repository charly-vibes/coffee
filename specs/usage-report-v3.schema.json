                "type": "integer"
              },
              "out": {
                "type": "integer"
              },
              "cache_read": {
                "type": "integer"
              },
              "cache_write": {
                "type": "integer"
              },
              "cost_eff": {
                "type": "number"
              },
              "cost_real": {
                "type": "number"
              }
            }
          }
        }
      }
    },
