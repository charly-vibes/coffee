{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "usage-report-v3.schema.json",
  "title": "usage_report_v3.json — contrato tracker → visualizaciones",
  "description": "Esquema del reporte que produce scripts/usage-tracker.py y consume viz-gantt.py y viz-fpa.py (el dashboard de insights fue eliminado en coffe-gen.5). Cambiar aquí implica regenerar golden (REGEN_GOLDEN=1) y bump de versión.",
  "type": "object",
  "required": [
    "metadata",
    "hourly",
    "daily",
    "monthly",
    "projects",
    "skills",
    "commands",
    "sessions",
    "multitasking",
    "project_daily",
    "subscription_config",
    "subscription_fees_by_month",
    "context_metrics",
    "project_daily_spend",
    "session_spend"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "required": [
        "date_range",
        "filter",
        "total_interactions",
        "total_days",
        "total_hours",
        "total_projects",
        "cost_total_effective",
        "cost_total_real",
        "subscription_fees"
      ],
      "properties": {
        "date_range": {
          "type": "object",
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "end": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            }
          }
        },
        "filter": {
          "enum": [
            "in-scope",
            "all"
          ]
        },
        "config_source": {
          "type": "string",
          "description": "coffe-mbz: fuente del config de suscripciones/pricing (ruta de config/fpa.json o 'builtin-fallback')"
        },
        "charges_total_real": {
          "description": "coffe-a31.2: suma IA total del ledger data/charges.json (USD, provenance reported)",
          "type": "number"
        },
        "charges_source": {
          "description": "coffe-a31.2: ruta del ledger consumido",
          "type": "string"
        },
        "charges_provenance": {
          "description": "coffe-a31.2: provenance del ledger (reported; unavailable si no se pudo leer — ver charges_reason)",
          "enum": [
            "reported",
            "unavailable"
          ]
        },
        "charges_reason": {
          "description": "coffe-a31.2 (FPA-008): razón si el ledger no está disponible; null si reported",
          "type": [
            "string",
            "null"
          ]
        },
        "energy_provenance": {
          "description": "coffe-7mj.1: la energía es SIEMPRE assumed (ningún proveedor reporta kWh); unavailable con energy_reason solo en fallback sin config (FPA-008).",
          "enum": [
            "assumed",
            "unavailable"
          ]
        },
        "energy_config_source": {
          "description": "coffe-7mj.1: config/fpa.json que proveyó los coeficientes (null en fallback).",
          "type": [
            "string",
            "null"
          ]
        },
        "energy_cache_read_factor": {
          "description": "coffe-7mj.1: factor aplicado a cache_read tokens (parámetro dominante del estimado).",
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "energy_method": {
          "description": "coffe-7mj.1: fórmula documentada del estimado.",
          "type": "string"
        },
        "energy_band_cache_factors": {
          "description": "coffe-5ng: factores de cache_read con los que se computan los extremos de energy_kwh_band mensual ([0.0, 1.0]). Ausente en fallback sin config.",
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "energy_reason": {
          "description": "coffe-7mj.1: razón de energy_provenance=unavailable (solo fallback).",
          "type": "string"
        },
        "cost_real_total_tracker": {
          "description": "coffe-a31.2: parte tracker del cost_total_real (p2p real estimado por el tracker, sin fees implícitos del calendario)",
          "type": "number"
        },
        "total_interactions": {
          "type": "integer",
          "minimum": 0
        },
        "total_input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "total_output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "total_cache_read_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "total_cache_write_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cost_total_effective": {
          "type": "number"
        },
        "cost_total_real": {
          "type": "number"
        },
        "subscription_fees": {
          "type": "number"
        },
        "token_accounting": {
          "type": "string"
        },
        "timezone": {
          "description": "FPA-142: TZ usada para bucketing horario/diario; ausente => vistas hora/día unverified",
          "type": [
            "string",
            "null"
          ]
        },
        "interaction_kinds": {
          "description": "FPA-140: interacciones por kind (user prompts, assistant turns, tool calls)",
          "type": "object",
          "properties": {
            "user_prompt": {
              "type": "integer",
              "minimum": 0
            },
            "assistant_turn": {
              "type": "integer",
              "minimum": 0
            },
            "tool_call": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "filtered": {
          "description": "FPA-141: interacciones y coste de los proyectos excluidos por el charly-filter",
          "type": "object",
          "required": [
            "interactions",
            "cost_effective"
          ],
          "properties": {
            "interactions": {
              "type": "integer",
              "minimum": 0
            },
            "cost_effective": {
              "type": "number"
            }
          }
        },
        "total_hours": {
          "type": "integer",
          "minimum": 0
        },
        "total_days": {
          "type": "integer",
          "minimum": 0
        },
        "total_months": {
          "type": "integer",
          "minimum": 0
        },
        "total_projects": {
          "type": "integer",
          "minimum": 0
        },
        "skipped_lines": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "object"
        }
      }
    },
    "hourly": {
      "type": "object",
      "patternProperties": {
        "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:00$": {
          "$ref": "#/definitions/hourlyBucket"
        }
      }
    },
    "daily": {
      "type": "object",
      "patternProperties": {
        "^[0-9]{4}-[0-9]{2}-[0-9]{2}$": {
          "$ref": "#/definitions/simpleBucket"
        }
      }
    },
    "monthly": {
      "type": "object",
      "patternProperties": {
        "^[0-9]{4}-[0-9]{2}$": {
          "$ref": "#/definitions/monthlyBucket"
        }
      }
    },
    "projects": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/projectBucket"
      }
    },
    "skills": {
      "type": "object"
    },
    "commands": {
      "type": "object"
    },
    "sessions": {
      "type": "object",
      "required": [
        "total_sessions",
        "length_distribution",
        "with_agent",
        "top_longest_by_turns"
      ],
      "properties": {
        "total_sessions": {
          "type": "integer",
          "minimum": 0
        },
        "length_distribution": {
          "type": "object"
        },
        "with_agent": {
          "type": "integer",
          "minimum": 0
        },
        "agent_semantics": {
          "description": "coffe-i31: alcance del flag has_agent por tool — la semántica de subagentes difiere por harness",
          "type": "string"
        },
        "by_tool": {
          "description": "coffe-i31: sesiones con provenance por tool. resets = señal de reset por harness (claude: /clear de history.jsonl; pi: 1 archivo de sesión = 1 /new; amp: 1 tarea = 1 corrida)",
          "type": "object",
          "patternProperties": {
            "^[a-z][a-z0-9-]*$": {
              "type": "object",
              "required": [
                "total",
                "with_agent",
                "resets"
              ],
              "properties": {
                "total": {
                  "type": "integer",
                  "minimum": 0
                },
                "with_agent": {
                  "type": "integer",
                  "minimum": 0
                },
                "resets": {
                  "type": "object",
                  "required": [
                    "signal",
                    "count"
                  ],
                  "properties": {
                    "signal": {
                      "type": "string"
                    },
                    "count": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          }
        },
        "total_api_errors": {
          "type": "integer"
        },
        "total_compactions": {
          "type": "integer",
          "minimum": 0
        },
        "avg_turns": {
          "type": "number"
        },
        "avg_tools": {
          "type": "number"
        },
        "avg_skills": {
          "type": "number"
        },
        "top_longest_by_turns": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "turns",
              "msgs",
              "date",
              "project"
            ],
            "properties": {
              "turns": {
                "type": "integer"
              },
              "msgs": {
                "type": "integer"
              },
              "date": {
                "type": "string"
              },
              "project": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "multitasking": {
      "type": "object",
      "required": [
        "hourly",
        "daily",
        "context_switches"
      ],
      "properties": {
        "description": {
          "type": "string"
        },
        "hourly": {
          "type": "object",
          "required": [
            "total_active_hours",
            "hours_with_multiple_projects",
            "pct_hours_multitasking",
            "max_projects_in_one_hour",
            "top_10_hours"
          ],
          "properties": {
            "total_active_hours": {
              "type": "integer",
              "minimum": 0
            },
            "hours_with_multiple_projects": {
              "type": "integer",
              "minimum": 0
            },
            "pct_hours_multitasking": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "avg_projects_per_active_hour": {
              "type": "number"
            },
            "distribution": {
              "type": "object"
            },
            "max_projects_in_one_hour": {
              "type": "object",
              "required": [
                "count",
                "hours",
                "projects"
              ],
              "properties": {
                "count": {
                  "type": "integer"
                },
                "hours": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "projects": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "top_10_hours": {
              "type": "array"
            }
          }
        },
        "daily": {
          "type": "object",
          "required": [
            "total_active_days",
            "days_with_multiple_projects",
            "pct_days_multitasking",
            "top_10_days"
          ],
          "properties": {
            "total_active_days": {
              "type": "integer",
              "minimum": 0
            },
            "days_with_multiple_projects": {
              "type": "integer",
              "minimum": 0
            },
            "pct_days_multitasking": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "avg_projects_per_active_day": {
              "type": "number"
            },
            "top_10_days": {
              "type": "array"
            }
          }
        },
        "context_switches": {
          "type": "object",
          "required": [
            "total",
            "avg_per_active_day",
            "max_in_one_day",
            "top_10_days"
          ],
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 0
            },
            "avg_per_active_day": {
              "type": "number"
            },
            "max_in_one_day": {
              "type": "integer",
              "minimum": 0
            },
            "top_10_days": {
              "type": "object"
            }
          }
        }
      }
    },
    "project_daily": {
      "type": "object",
      "required": [
        "days",
        "matrix"
      ],
      "properties": {
        "days": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          }
        },
        "matrix": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "concurrency": {
      "description": "FPA-120: (a) proyectos distintos por hora (en hourlyBucket.projects_active), (b) pico de sesiones simultáneas, (c) project switches por hora activa",
      "type": "object",
      "properties": {
        "distinct_projects_per_hour": {
          "type": "object",
          "properties": {
            "measure": {
              "enum": [
                "parallel-agent",
                "human-context-switching"
              ]
            },
            "peak": {
              "type": "integer",
              "minimum": 0
            },
            "avg": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "peak_simultaneous_sessions": {
          "type": "object",
          "properties": {
            "measure": {
              "enum": [
                "parallel-agent",
                "human-context-switching"
              ]
            },
            "peak": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "reason": {
              "type": [
                "string",
                "null"
              ],
              "description": "coffe-6i8: null cuando el pico SÍ es computable; string con la razón solo cuando es n/a (FPA-008)"
            }
          }
        },
        "project_switches_per_active_hour": {
          "type": "object",
          "properties": {
            "measure": {
              "enum": [
                "parallel-agent",
                "human-context-switching"
              ]
            },
            "value": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            }
          }
        },
        "peak_simultaneous_sessions_legacy": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "switches_per_active_hour": {
          "type": [
            "number",
            "null"
          ]
        },
        "description": {
          "type": "string"
        }
      }
    },
    "project_monthly": {
      "description": "FPA-012: project totals por mes (proyecto → mes → interacciones/coste). d1: coste real del ledger + tokens por tipo para la timeline de volumen del dashboard (add-project-cost-token-timeline, coffe-t1.2)",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "patternProperties": {
          "^[0-9]{4}-[0-9]{2}$": {
            "type": "object",
            "required": [
              "interactions",
              "cost_effective",
              "cost_real",
              "tokens"
            ],
            "properties": {
              "interactions": {
                "type": "integer",
                "minimum": 0
              },
              "cost_effective": {
                "type": "number",
                "minimum": 0
              },
              "cost_real": {
                "type": "number",
                "minimum": 0
              },
              "tokens": {
                "type": "object",
                "required": [
                  "in",
                  "out",
                  "cache_read",
                  "cache_write"
                ],
                "properties": {
                  "in": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "out": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "cache_read": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "cache_write": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        }
      }
    },
    "project_models": {
      "description": "FPA-021: proyecto → modelo → interacciones/coste (drill Project→Model)",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "required": [
            "interactions",
            "cost_effective"
          ],
          "properties": {
            "interactions": {
              "type": "integer",
              "minimum": 0
            },
            "cost_effective": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    },
    "sessions_monthly": {
      "description": "Sesiones por mes (KPIs: coste por sesión, autonomous share) — coffe-i31: incluye todas las tools (claude + pi + amp)",
      "type": "object",
      "patternProperties": {
        "^[0-9]{4}-[0-9]{2}$": {
          "type": "object",
          "required": [
            "total",
            "with_agent"
          ],
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 0
            },
            "with_agent": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "filtered_out": {
      "description": "FPA-141: interacciones y coste excluidos por el filtro charly",
      "type": "object",
      "required": [
        "interactions",
        "cost_effective",
        "by_tool",
        "share"
      ],
      "properties": {
        "interactions": {
          "type": "integer",
          "minimum": 0
        },
        "cost_effective": {
          "type": "number",
          "minimum": 0
        },
        "by_tool": {
          "type": "object"
        },
        "share": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "subscription_config": {
      "type": "object"
    },
    "subscription_fees_by_month": {
      "type": "object",
      "patternProperties": {
        "^[0-9]{4}-[0-9]{2}$": {
          "type": "number"
        }
      }
    },
    "charges_real_by_month": {
      "description": "coffe-a31.2 (CRG-F1): cash cost real del ledger data/charges.json por proveedor y mes (YYYY-MM → USD), solo kinds IA (subscription|credits|refund|api_cycle aporta $0), provenance reported (facturas, FPA-003). Medida separada del coste efectivo: jamás sumarlas (FPA-002)",
      "type": "object",
      "patternProperties": {
        "^[a-z0-9-]+$": {
          "type": "object",
          "patternProperties": {
            "^[0-9]{4}-[0-9]{2}$": {
              "type": "number"
            }
          }
        }
      }
    },
    "charges_reconciliation_by_month": {
      "description": "coffe-a31.2: insumo de reconciliación FPA-082 — por mes y tool: charges_real (ledger, reported), subscription_fee_implicit (calendario, assumed; NO es cash), cost_effective (tracker, assumed), fee_month_total",
      "type": "object",
      "patternProperties": {
        "^[0-9]{4}-[0-9]{2}$": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "charges_real",
              "charges_provenance",
              "subscription_fee_implicit",
              "cost_effective"
            ],
            "properties": {
              "charges_real": {
                "type": "number"
              },
              "charges_provenance": {
                "enum": [
                  "reported"
                ]
              },
              "subscription_fee_implicit": {
                "type": "number"
              },
              "cost_effective": {
                "type": "number"
              },
              "fee_month_total": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "model_pricing_config": {
      "type": "object",
      "description": "coffe-mbz: config de pricing cargado (default_rates, cache_write_factor, versions) — lo usado para calcular costes, no constantes hardcodeadas"
    },
    "context_metrics": {
      "description": "ctx-tracker (epic add-context-dashboard, coffe-kup): métricas de contexto por sesión de Pi. reducer puro reduce_context() + aggregate_context(); pico por segmento de compactación (CORR-001), atribución de chars por fuente, models_turns (CORR-002), coste ausente → null con razón (nunca 0 fake), patologías contadas en meta (excluidas de percentiles). Estimación: chars/chars_per_token (assumed, subestima). Pi-only: Claude/Amp/Codex fuera del alcance.",
      "type": "object",
      "required": [
        "available",
        "sessions",
        "monthly_model",
        "meta"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "sessions": {
          "type": "array",
          "description": "fila por sesión de Pi in-scope con turns > 0; stubs fuera (meta.stubs); patológicas listadas pero excluidas de percentiles",
          "items": {
            "type": "object",
            "required": [
              "month",
              "project",
              "turns",
              "peak_ctx_est",
              "final_ctx_est",
              "compactions",
              "chars_by_source",
              "big_results",
              "cost_in",
              "cost_out",
              "cost_cr",
              "cost_cw",
              "context_source",
              "pathological",
              "model",
              "models_turns"
            ],
            "properties": {
              "month": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}$",
                "description": "desde el filename del archivo de sesión (documentado)"
              },
              "project": {
                "type": "string"
              },
              "turns": {
                "type": "integer",
                "minimum": 1
              },
              "turns_no_usage": {
                "type": "integer",
                "minimum": 0
              },
              "tokens_reported": {
                "type": "integer",
                "minimum": 0
              },
              "chars_by_source": {
                "type": "object",
                "description": "asst_text/asst_thinking/asst_args/tool:<name>/user_text — suma == transcript observado",
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "big_results": {
                "type": "integer",
                "minimum": 0
              },
              "big_results_by_tool": {
                "type": "object"
              },
              "compactions": {
                "type": "integer",
                "minimum": 0
              },
              "segment_count": {
                "type": "integer",
                "minimum": 1
              },
              "peak_ctx_chars": {
                "type": "integer",
                "minimum": 0
              },
              "final_ctx_chars": {
                "type": "integer",
                "minimum": 0
              },
              "peak_ctx_est": {
                "type": "integer",
                "minimum": 0
              },
              "final_ctx_est": {
                "type": "integer",
                "minimum": 0
              },
              "max_assistant_block_chars": {
                "type": "integer",
                "minimum": 0
              },
              "chars_per_token": {
                "type": "integer"
